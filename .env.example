# SMTP-Zugang für den Versand von Kontaktanfragen und Bewerbungen
# (z. B. das Postfach info@perfectjob-mainz.de beim E-Mail-Anbieter)
SMTP_HOST=smtp.example.de
SMTP_PORT=465
SMTP_USER=info@perfectjob-mainz.de
SMTP_PASS=

# Absender und Empfänger
MAIL_FROM="Perfect Job Website <info@perfectjob-mainz.de>"
MAIL_TO=info@perfectjob-mainz.de
